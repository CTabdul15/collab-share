{
  "name": "collab-share",
  "displayName": "Collab Share",
  "description": "Free Live Share alternative: code together in real time with friends anywhere. Shared editing, cursors, IntelliSense from the host, and a blueprint Sandbox with a live logic and fluid power simulator.",
  "version": "1.2.3",
  "publisher": "CTabdul15",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#123f7a",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CTabdul15/collab-share.git"
  },
  "bugs": {
    "url": "https://github.com/CTabdul15/collab-share/issues"
  },
  "homepage": "https://github.com/CTabdul15/collab-share#readme",
  "pricing": "Free",
  "categories": [
    "Other",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "live share",
    "collaboration",
    "pair programming",
    "real-time",
    "co-editing",
    "multiplayer",
    "whiteboard",
    "logic gates",
    "remote",
    "share"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onFileSystem:collab"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "collab.host",
        "title": "Start Hosting Session",
        "category": "Collab",
        "icon": "$(broadcast)"
      },
      {
        "command": "collab.hostReadWrite",
        "title": "Share (Read/Write)",
        "category": "Collab",
        "icon": "$(broadcast)"
      },
      {
        "command": "collab.hostReadOnly",
        "title": "Share (Read-Only)",
        "category": "Collab",
        "icon": "$(lock)"
      },
      {
        "command": "collab.join",
        "title": "Join Session",
        "category": "Collab",
        "icon": "$(plug)"
      },
      {
        "command": "collab.stop",
        "title": "Stop / Leave Session",
        "category": "Collab",
        "icon": "$(debug-stop)"
      },
      {
        "command": "collab.copyInvite",
        "title": "Copy Invite Link",
        "category": "Collab",
        "icon": "$(copy)"
      },
      {
        "command": "collab.findFile",
        "title": "Find File in Shared Workspace",
        "category": "Collab",
        "icon": "$(search)"
      },
      {
        "command": "collab.restartTunnel",
        "title": "Restart Internet Link",
        "category": "Collab",
        "icon": "$(globe)"
      },
      {
        "command": "collab.menu",
        "title": "Session Menu",
        "category": "Collab"
      },
      {
        "command": "collab.goToPeer",
        "title": "Go to Participant",
        "category": "Collab"
      },
      {
        "command": "collab.follow",
        "title": "Follow",
        "category": "Collab",
        "icon": "$(pin)"
      },
      {
        "command": "collab.unfollow",
        "title": "Stop Following",
        "category": "Collab",
        "icon": "$(pinned)"
      },
      {
        "command": "collab.undo",
        "title": "Undo My Last Change",
        "category": "Collab"
      },
      {
        "command": "collab.redo",
        "title": "Redo My Last Change",
        "category": "Collab"
      },
      {
        "command": "collab.setReadOnly",
        "title": "Make Read-Only",
        "category": "Collab",
        "icon": "$(lock)"
      },
      {
        "command": "collab.setReadWrite",
        "title": "Allow Editing",
        "category": "Collab",
        "icon": "$(unlock)"
      },
      {
        "command": "collab.whiteboard",
        "title": "Open Sandbox",
        "category": "Collab",
        "icon": "$(symbol-color)"
      },
      {
        "command": "collab.setPicture",
        "title": "Set My Picture…",
        "category": "Collab",
        "icon": "$(account)"
      },
      {
        "command": "collab.changeColor",
        "title": "Change Color…",
        "category": "Collab",
        "icon": "$(symbol-color)"
      }
    ],
    "views": {
      "collab": [
        {
          "id": "collab.session",
          "name": "Session Details"
        },
        {
          "id": "collab.participants",
          "name": "Participants"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "collab.session",
        "contents": "Start collaboratively editing with others in real-time.\n[Share (Read/Write)](command:collab.hostReadWrite)\n[Share (Read-Only)](command:collab.hostReadOnly)\n[Join](command:collab.join)",
        "when": "!collab.role"
      },
      {
        "view": "collab.participants",
        "contents": "No one else is here yet. Share the invite link with your friends.\n[Copy Invite Link](command:collab.copyInvite)",
        "when": "collab.role == host"
      },
      {
        "view": "collab.participants",
        "contents": "Start or join a session to see participants here.",
        "when": "!collab.role"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "collab.whiteboard",
          "when": "view == collab.session && collab.role",
          "group": "navigation@0"
        },
        {
          "command": "collab.copyInvite",
          "when": "view == collab.session && collab.role == host",
          "group": "navigation@1"
        },
        {
          "command": "collab.findFile",
          "when": "view == collab.session && collab.role == guest",
          "group": "navigation@1"
        },
        {
          "command": "collab.stop",
          "when": "view == collab.session && collab.role",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "collab.follow",
          "when": "view == collab.participants && viewItem =~ /notfollowing/",
          "group": "inline@1"
        },
        {
          "command": "collab.unfollow",
          "when": "view == collab.participants && viewItem =~ /(^| )following/",
          "group": "inline@1"
        },
        {
          "command": "collab.setReadOnly",
          "when": "view == collab.participants && viewItem =~ /guest-rw/",
          "group": "inline@2"
        },
        {
          "command": "collab.setReadWrite",
          "when": "view == collab.participants && viewItem =~ /guest-ro/",
          "group": "inline@2"
        },
        {
          "command": "collab.goToPeer",
          "when": "view == collab.participants && viewItem =~ /following/",
          "group": "1_peer@1"
        },
        {
          "command": "collab.follow",
          "when": "view == collab.participants && viewItem =~ /notfollowing/",
          "group": "1_peer@2"
        },
        {
          "command": "collab.unfollow",
          "when": "view == collab.participants && viewItem =~ /(^| )following/",
          "group": "1_peer@2"
        },
        {
          "command": "collab.setReadOnly",
          "when": "view == collab.participants && viewItem =~ /guest-rw/",
          "group": "2_perm"
        },
        {
          "command": "collab.setReadWrite",
          "when": "view == collab.participants && viewItem =~ /guest-ro/",
          "group": "2_perm"
        },
        {
          "command": "collab.changeColor",
          "when": "view == collab.participants && viewItem =~ /recolor/",
          "group": "inline@3"
        },
        {
          "command": "collab.changeColor",
          "when": "view == collab.participants && viewItem =~ /recolor/",
          "group": "2_perm@2"
        }
      ],
      "commandPalette": [
        {
          "command": "collab.goToPeer",
          "when": "false"
        },
        {
          "command": "collab.follow",
          "when": "false"
        },
        {
          "command": "collab.unfollow",
          "when": "collab.role"
        },
        {
          "command": "collab.findFile",
          "when": "collab.role == guest"
        },
        {
          "command": "collab.copyInvite",
          "when": "collab.role == host"
        },
        {
          "command": "collab.restartTunnel",
          "when": "collab.role == host"
        },
        {
          "command": "collab.hostReadWrite",
          "when": "!collab.role"
        },
        {
          "command": "collab.hostReadOnly",
          "when": "!collab.role"
        },
        {
          "command": "collab.undo",
          "when": "collab.role"
        },
        {
          "command": "collab.redo",
          "when": "collab.role"
        },
        {
          "command": "collab.setReadOnly",
          "when": "false"
        },
        {
          "command": "collab.setReadWrite",
          "when": "false"
        },
        {
          "command": "collab.whiteboard",
          "when": "collab.role"
        },
        {
          "command": "collab.changeColor",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "collab.findFile",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "collab.role == guest"
      },
      {
        "command": "collab.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && !editorReadonly && collab.role"
      },
      {
        "command": "collab.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && !editorReadonly && collab.role"
      },
      {
        "command": "collab.redo",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus && !editorReadonly && collab.role"
      }
    ],
    "configuration": {
      "title": "Collab Share",
      "properties": {
        "collab.displayName": {
          "type": "string",
          "default": "",
          "description": "Your name as shown to other participants."
        },
        "collab.port": {
          "type": "number",
          "default": 7171,
          "description": "Port the host listens on."
        },
        "collab.shareOverInternet": {
          "type": "boolean",
          "default": true,
          "description": "When hosting, automatically create a free Cloudflare link (…trycloudflare.com) so friends on other networks can join. Requires cloudflared on the host's computer."
        },
        "collab.cloudflaredPath": {
          "type": "string",
          "default": "",
          "description": "Path to the cloudflared executable, if it isn't found automatically."
        },
        "collab.publicUrl": {
          "type": "string",
          "default": "",
          "description": "When hosting through a tunnel (cloudflared, ngrok, VS Code port forwarding), the public URL that forwards to your port, e.g. https://abc.trycloudflare.com. Used to build the invite link."
        },
        "collab.performanceOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Show a small performance panel in the top-left corner of the Sandbox: CPU and RAM of VS Code's extension host (where this extension runs) and of the whole device, plus GPU load when the system reports it."
        }
      }
    },
    "colors": [
      {
        "id": "collab.participant0",
        "description": "Color of collaborator #0 (file highlights)",
        "defaults": {
          "dark": "#ff5c7a",
          "light": "#e6194b",
          "highContrast": "#ff5c7a",
          "highContrastLight": "#e6194b"
        }
      },
