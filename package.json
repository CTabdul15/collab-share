    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "collab",
          "title": "Collab Share",
          "icon": "resources/collab.svg"
        }
      ]
    },
    "resourceLabelFormatters": [
      {
        "scheme": "collab",
        "authority": "*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "workspaceSuffix": "Collab Share"
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs && node test/run.mjs",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.85.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
